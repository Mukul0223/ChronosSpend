# ChronosSpend environment variable NAMES. Never put real values in this file.
# Copy the ones you need into .env.local (dev project) and fill them in there.

# --- Used by the app (website and extension build) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=

# --- GitHub Actions secrets only (set on github.com, not in a local file) ---
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# --- Playwright test accounts on the DEV project only (Milestone 15) ---
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_USER2_EMAIL=
E2E_USER2_PASSWORD=
